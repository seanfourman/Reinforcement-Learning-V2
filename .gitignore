# Source-asset rips at the REPO ROOT only (huge, not needed to run the game -
# the subsets the game actually uses are vendored into game/assets/). The
# leading slash anchors these to the root so they do NOT also ignore nested
# folders like game/assets/models/characters/ (which IS needed at runtime).
/docs/
/levels/
/characters/
/assets/
.DS_Store
__pycache__/
*.py[cod]
/.claude/
# Local dev scratch: server logs + temp preview pages (never needed to run).
/tmp/
game/_*_tmp.html
game/*preview*.html

# Runtime-trained Round 4 models (local learning state, potentially large).
/checkpoints/*.pt
/checkpoints/.*.tmp
